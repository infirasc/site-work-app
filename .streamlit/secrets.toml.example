# Streamlit Community Cloud 배포용 secrets 예시 파일 — 실제 키를 넣지 마세요.
#
# 로컬에서는 프로젝트 루트의 .env(OPENAI_API_KEY=...)를 그대로 쓰면 되고, 이 파일은
# 필요 없습니다. 이 파일이 실제로 필요한 곳은 Streamlit Community Cloud 배포 화면의
# "Secrets" 설정창입니다 — .env는 .gitignore에 있어서 배포 서버에 안 올라가기 때문에,
# 배포할 때는 여기 적힌 것과 같은 TOML 형식으로 그 설정창에 직접 붙여넣어야 합니다.
#
# 사용법: 아래 내용을 그대로 복사해서 Streamlit Cloud 앱 설정 > Secrets에 붙여넣고,
# sk-... 자리에 실제 OPENAI_API_KEY 값을 넣으세요.

OPENAI_API_KEY = "sk-여기에-실제-키를-붙여넣으세요"
